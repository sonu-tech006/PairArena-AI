# PairArena AI Environment Configuration
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:3000

# Existing MongoDB connection (used for data persistence and GridFS bucket storage)
MONGODB_URI=your_existing_mongodb_connection_string

# Security & Sessions
JWT_SECRET=your_strong_jwt_secret_key_change_in_production
COOKIE_SECRET=your_cookie_secret_key_change_in_production

# AI Tutoring (Google Gemini API)
# In Google AI Studio, this is injected automatically in Secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Code execution (Wandbox API)
# Uses https://wandbox.org/api/compile.json for multi-language execution
CODE_EXECUTION_PROVIDER=wandbox
WANDBOX_BASE_URL=https://wandbox.org/api

# File storage (MongoDB GridFS bucket 'uploads')
STORAGE_PROVIDER=gridfs

# Learning Resources (YouTube Data API v3 - Optional)
YOUTUBE_API_KEY=

# Email Delivery (Optional)
EMAIL_PROVIDER_API_KEY=
